# --- Cartographie / routing / geocodage ------------------------------------
# OPTIONNEL. Sans ce token, l'application utilise ses providers open source par
# defaut (MapLibre + tuiles CARTO/OSM, geocodage BAN data.gouv, routing OSRM).
#
# Ce token N'EST PAS un secret : il est publie dans le bundle frontend.
# Utiliser IMPERATIVEMENT un token PUBLIC Mapbox de type pk.*
# Ne JAMAIS utiliser un token secret sk.*
# Restreindre le token aux domaines autorises (localhost + domaine de prod).
VITE_MAPBOX_PUBLIC_TOKEN=

VITE_APP_ENV=development

# Chemin de base du deploiement statique.
# GitHub Pages : /kiwiture/ (valeur par defaut)
# Racine de domaine (Netlify, Vercel, Cloudflare Pages, S3) : /
# VITE_BASE=/
